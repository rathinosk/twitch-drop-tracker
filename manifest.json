{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content-main.js" ],
      "matches": [ "https://www.twitch.tv/drops/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "content-isolated.js" ],
      "matches": [ "https://www.twitch.tv/drops/*" ],
      "run_at": "document_start"
   } ],
   "description": "Track your Twitch drops campaigns and progress, sorted by expiration date",
   "host_permissions": [ "https://www.twitch.tv/*", "https://gql.twitch.tv/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Twitch Drop Tracker",
   "permissions": [ "storage", "cookies", "scripting", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.3.7",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "fullpage/*", "icons/*", "locales/*", "i18n.js" ]
   } ]
}
